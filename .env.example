# ==========================================================
# Plantilla de variables de entorno.
# Copia este archivo como ".env" y completa los valores.
# ".env" y ".env.local" están en .gitignore: NUNCA se suben.
# En GitHub Actions estos valores van como Repository Secrets.
# ==========================================================

# --- PostgreSQL (Neon) ---
# En local NO hace falta escribirla: `neon deploy` agrega a este .env
# DATABASE_URL_UNPOOLED (directa, la que usa el pipeline) y DATABASE_URL (pooler).
# En GitHub Actions: secret DATABASE_URL con la cadena DIRECTA (host sin "-pooler").
DATABASE_URL=postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Contraseña del rol de solo lectura usado por Power BI (lo crea scripts/crear_rol_powerbi.py)
POWERBI_LECTOR_PASSWORD=

# --- Kaggle (credenciales legacy, archivo kaggle.json) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Simulador de llegada de datos ---
# Días de pedidos que se cargan en cada ejecución diaria
BATCH_DAYS=7
# Fecha hasta la que llega la carga inicial (backfill manual)
FECHA_CARGA_INICIAL=2017-12-31

# --- Logging ---
LOG_LEVEL=INFO
